From 72175c041c59220ea4be1c5299983e9486cb3c1d Mon Sep 17 00:00:00 2001
From: Luis Felipe Strano Moraes <luis.strano@gmail.com>
Date: Sat, 14 Nov 2026 05:06:31 -0800
Subject: [PATCH] Skip flat-mesh fog work for fully clear bounds

Use static custom-mesh bounds to bypass per-face fog checks when the whole object lies before the fog start plane. Keep animated, unbounded and partially fogged meshes on the existing path.

Check the inclusive fog boundary, signed depths, invalid radii and overflow in a portable test. All six portable PS1 clipping, projection, palette and fog-bound tests pass with address and undefined-behavior sanitizers.
---
 src/CMakeLists.txt                         |  3 +++
 templates/ps1/starter/runtime/fog_bounds.h | 11 +++++++++++
 templates/ps1/starter/runtime/render.c     | 15 +++++++++++----
 tests/Ps1FogBoundsTests.c                  | 22 ++++++++++++++++++++++
 4 files changed, 47 insertions(+), 4 deletions(-)
 create mode 100644 templates/ps1/starter/runtime/fog_bounds.h
 create mode 100644 tests/Ps1FogBoundsTests.c

diff --git a/src/CMakeLists.txt b/src/CMakeLists.txt
index 7fe3f73..69a3c86 100644
--- a/src/CMakeLists.txt
+++ b/src/CMakeLists.txt
@@ -371,6 +371,9 @@ add_test(NAME MipsyncPs1ClipMath COMMAND MipsyncPs1ClipMathTests)
 add_executable(MipsyncPs1GpuClippingTests
     ${CMAKE_SOURCE_DIR}/tests/Ps1GpuClippingTests.c)
 add_test(NAME MipsyncPs1GpuClipping COMMAND MipsyncPs1GpuClippingTests)
+add_executable(MipsyncPs1FogBoundsTests
+    ${CMAKE_SOURCE_DIR}/tests/Ps1FogBoundsTests.c)
+add_test(NAME MipsyncPs1FogBounds COMMAND MipsyncPs1FogBoundsTests)
 add_executable(MipsyncPs1WorldProjectionTests
     ${CMAKE_SOURCE_DIR}/tests/Ps1WorldProjectionTests.c)
 add_test(NAME MipsyncPs1WorldProjection COMMAND MipsyncPs1WorldProjectionTests)
diff --git a/templates/ps1/starter/runtime/fog_bounds.h b/templates/ps1/starter/runtime/fog_bounds.h
new file mode 100644
index 0000000..c1c8066
--- /dev/null
+++ b/templates/ps1/starter/runtime/fog_bounds.h
@@ -0,0 +1,11 @@
+#ifndef MIPSYNC_FOG_BOUNDS_H
+#define MIPSYNC_FOG_BOUNDS_H
+#include <stdint.h>
+
+/* Touching the start plane still has zero fog. Widen the sum so distant
+ * or oversized bounds cannot wrap into the clear range. */
+static inline int ps1_bound_before_fog(int32_t center_z, int32_t radius,
+                                      int32_t fog_start_z) {
+    return radius >= 0 && (int64_t)center_z + radius <= fog_start_z;
+}
+#endif
diff --git a/templates/ps1/starter/runtime/render.c b/templates/ps1/starter/runtime/render.c
index 057e42a..4899d45 100644
--- a/templates/ps1/starter/runtime/render.c
+++ b/templates/ps1/starter/runtime/render.c
@@ -10,6 +10,7 @@
 #include "viewmodel_projection.h"
 #include "clip_math.h"
 #include "projection_safety.h"
+#include "fog_bounds.h"
 #include "watertight_projection.h"
 #include "affine_subdivision.h"
 #include "world_projection.h"
@@ -2506,14 +2507,13 @@ static int draw_cached_flat_mesh(char** pri, const char* packet_end, uint32_t* o
                                  int default_use_tex, uint16_t default_tpage,
                                  uint16_t default_clut,
                                  int default_uoff, int default_voff, int skip_unsafe,
-                                 const uint16_t* visible_triangles, uint16_t visible_count) {
+                                 const uint16_t* visible_triangles, uint16_t visible_count, int fog_enabled) {
     unsigned int cached_texture_index = 0xffffffffu;
     int cached_use_tex = 0;
     uint16_t cached_tpage = 0;
     uint16_t cached_clut = 0;
     int cached_uoff = 0;
     int cached_voff = 0;
-    const int fog_enabled = g_ps1_scene.fog_enabled;
     const ps1_static_topology_cache* topology =
         ent->vertex_anim_frame_count == 0
             ? static_topology_cache_for(mesh) : 0;
@@ -2626,7 +2626,7 @@ static int draw_cached_flat_mesh(char** pri, const char* packet_end, uint32_t* o
             continue;
         if (!visible_triangles && (z0 < near_z || z1 < near_z || z2 < near_z))
             continue;
-        if (discard_solid_fog_triangle(z0, z1, z2))
+        if (fog_enabled && discard_solid_fog_triangle(z0, z1, z2))
             continue;
         if (fog_enabled && !ps1_texture_has_cutout(face->texture_index ? face->texture_index : ent->texture_index) && z0 >= s_fog_solid_z && z1 >= s_fog_solid_z &&
             z2 >= s_fog_solid_z) {
@@ -3221,6 +3221,7 @@ static int draw_entity(char** pri, const char* packet_end, uint32_t* ot, const p
     int     shell_ot_bias = 0;
     int     added = 0;
     int     shared_character_transform_hit = 0;
+    int fog_bounds_clear = !g_ps1_scene.fog_enabled;
     const int is_viewmodel = entity_is_viewmodel(ent);
     const ps1_entity* viewmodel_source = is_viewmodel && !entity_rigid_frame(ent)
         ? source_entity_by_id(ent->id) : 0;
@@ -3499,6 +3500,12 @@ static int draw_entity(char** pri, const char* packet_end, uint32_t* ot, const p
             bounding_radius = 128;
         }
 
+        /* A fully clear conservative bound certifies zero fog for every
+         * face. Keep partially fogged meshes on the per-vertex path. */
+        fog_bounds_clear = !g_ps1_scene.fog_enabled ||
+            (bounds_mesh && bounds_mesh->bounds_radius > 0 && !rigid_frame &&
+             ent->vertex_anim_frame_count == 0 &&
+             ps1_bound_before_fog(cull_z, bounding_radius, s_fog_start_z));
         if (cull_z + bounding_radius < s_near_z)
             return 0;
         /* Reject the entire object early when its closest bound is already
@@ -4074,7 +4081,7 @@ static int draw_entity(char** pri, const char* packet_end, uint32_t* ot, const p
                     use_tex, tpage, clut, tex_uoff, tex_voff,
                     static_cache->needs_safe_clip,
                     static_cache->visible_list_valid ? &s_static_visible_triangles[static_triangle_offset] : 0,
-                    static_cache->visible_triangle_count);
+                    static_cache->visible_triangle_count, !fog_bounds_clear);
                 if (!static_cache->needs_safe_clip)
                     return fast_added;
                 added += fast_added;
diff --git a/tests/Ps1FogBoundsTests.c b/tests/Ps1FogBoundsTests.c
new file mode 100644
index 0000000..58d7232
--- /dev/null
+++ b/tests/Ps1FogBoundsTests.c
@@ -0,0 +1,22 @@
+#include <limits.h>
+#include <stdio.h>
+#include <stdlib.h>
+#include "../templates/ps1/starter/runtime/fog_bounds.h"
+
+static void check(int condition, const char* message) {
+    if (!condition) { fprintf(stderr, "%s\n", message); exit(1); }
+}
+
+int main(void) {
+    check(ps1_bound_before_fog(100, 20, 121), "A fully clear sphere needs no fog");
+    check(ps1_bound_before_fog(100, 20, 120), "Touching the start plane has zero fog");
+    check(!ps1_bound_before_fog(100, 20, 119), "A partially fogged sphere keeps vertex fog");
+    check(!ps1_bound_before_fog(200, 20, 120), "A sphere beyond the start plane keeps fog");
+    check(ps1_bound_before_fog(-100, 20, -80), "Signed camera depths retain the boundary");
+    check(!ps1_bound_before_fog(0, -1, 100), "An invalid radius cannot certify clear geometry");
+    check(!ps1_bound_before_fog(INT_MAX, 1, INT_MAX), "Positive overflow must not disable fog");
+    check(ps1_bound_before_fog(INT_MIN, INT_MAX, -1), "A wide signed sum stays exact");
+    check(ps1_bound_before_fog(INT_MAX, 0, INT_MAX), "A zero-radius bound retains its plane");
+    puts("PS1 fog-bound tests passed");
+    return 0;
+}
