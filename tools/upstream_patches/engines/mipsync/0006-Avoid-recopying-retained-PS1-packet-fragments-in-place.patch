From 09a44c81bfc1d543c6d00271584d1922ef019a5c Mon Sep 17 00:00:00 2001
From: Luis Felipe Strano Moraes <luis.strano@gmail.com>
Date: Sun, 15 Nov 2026 07:33:48 -0800
Subject: [PATCH] Avoid recopying retained PS1 packet fragments in place

Keep existing payload and internal links when CPU storage and DMA addresses are unchanged. Still replace each bucket tail with the current ordering-table predecessor, and restore its head.

Cover repeated in-place reuse, distinct storage at the same DMA address and relocation within the same storage in the portable fragment test.
---
 .../ps1/starter/runtime/packet_fragment.h     | 26 ++++++++-------
 tests/Ps1PacketFragmentTests.c                | 33 +++++++++++++++++++
 2 files changed, 48 insertions(+), 11 deletions(-)

diff --git a/templates/ps1/starter/runtime/packet_fragment.h b/templates/ps1/starter/runtime/packet_fragment.h
index 2444bd9..dde99ad 100644
--- a/templates/ps1/starter/runtime/packet_fragment.h
+++ b/templates/ps1/starter/runtime/packet_fragment.h
@@ -72,17 +72,21 @@ static inline void ps1_packet_fragment_copy(uint32_t* target,
     const uint32_t* source, size_t words, uint32_t source_address,
     uint32_t target_address, uint32_t* ot,
     const ps1_packet_fragment_bucket* entries, size_t entry_count) {
-    size_t index = 0;
-    while (index < words) {
-        const uint32_t tag = source[index];
-        const uint32_t address = tag & 0xffffffu;
-        const size_t length = 1u + (tag >> 24);
-        const uint32_t link = address != 0xffffffu && address >= source_address &&
-            address - source_address < words * 4u
-            ? target_address + address - source_address : 0xffffffu;
-        for (size_t i = 1; i < length; ++i) target[index + i] = source[index + i];
-        target[index] = (tag & 0xff000000u) | link;
-        index += length;
+    /* Retained commands at the same CPU and DMA addresses already have valid
+     * internal links and payload. Only bucket tails need this frame's heads. */
+    if (target != source || target_address != source_address) {
+        size_t index = 0;
+        while (index < words) {
+            const uint32_t tag = source[index];
+            const uint32_t address = tag & 0xffffffu;
+            const size_t length = 1u + (tag >> 24);
+            const uint32_t link = address != 0xffffffu && address >= source_address &&
+                address - source_address < words * 4u
+                ? target_address + address - source_address : 0xffffffu;
+            for (size_t i = 1; i < length; ++i) target[index + i] = source[index + i];
+            target[index] = (tag & 0xff000000u) | link;
+            index += length;
+        }
     }
     for (size_t i = 0; i < entry_count; ++i) {
         const ps1_packet_fragment_bucket entry = entries[i];
diff --git a/tests/Ps1PacketFragmentTests.c b/tests/Ps1PacketFragmentTests.c
index ea23a1a..20c1be2 100644
--- a/tests/Ps1PacketFragmentTests.c
+++ b/tests/Ps1PacketFragmentTests.c
@@ -85,6 +85,39 @@ int main(void) {
         check(overlap[1]==packets[1] && overlap[3]==packets[3] && overlap[5]==packets[5] && overlap[6]==untouched,
               "Overlapping copies preserve payload and following memory");
     }
+    {
+        uint32_t retained[7], target[6];
+        memcpy(retained,packets,sizeof packets);
+        retained[6]=0xfeedfaceu;
+        check(CAPTURE(retained,6,0x4000u,ot,4), "In-place commands are captured before reuse");
+        for(unsigned frame=0;frame<100;++frame) {
+            const uint32_t previous=0xb000u+frame*4u;
+            uint32_t heads[4]={0xffffffu,previous,0x9004u,previous+0x1000u};
+            ps1_packet_fragment_copy(retained,retained,6,0x4000u,0x4000u,heads,entries,count);
+            check(retained[0]==(0x01000000u|previous) &&
+                  retained[4]==(0x01000000u|(previous+0x1000u)),
+                  "In-place reuse replaces both previous-frame predecessors");
+            check(retained[2]==0x01004000u && heads[1]==0x4008u && heads[3]==0x4010u,
+                  "In-place reuse preserves internal links and restores bucket heads");
+            check(retained[1]==packets[1] && retained[3]==packets[3] &&
+                  retained[5]==packets[5] && retained[6]==0xfeedfaceu && heads[2]==0x9004u,
+                  "In-place reuse preserves payload, foreign buckets and following storage");
+        }
+        memset(target,0,sizeof target);
+        {
+            uint32_t heads[4]={0xffffffu,0xb000u,0x9004u,0xb100u};
+            ps1_packet_fragment_copy(target,packets,6,0x4000u,0x4000u,heads,entries,count);
+            check(target[1]==packets[1] && target[2]==0x01004000u,
+                  "Equal DMA bases with distinct CPU buffers still copy their payload");
+        }
+        {
+            uint32_t heads[4]={0xffffffu,0xb000u,0x9004u,0xb100u};
+            memcpy(retained,packets,sizeof packets);
+            ps1_packet_fragment_copy(retained,retained,6,0x4000u,0x8000u,heads,entries,count);
+            check(retained[2]==0x01008000u && heads[1]==0x8008u,
+                  "In-place relocation with a changed DMA base still rebases links");
+        }
+    }
     {
         uint32_t packet=0x00ffffffu, table[1]={0xfffffcu};
         check(ps1_packet_fragment_capture(&packet,1,0xfffffcu,table,1,entries,4,scratch,2,&count),
-- 
