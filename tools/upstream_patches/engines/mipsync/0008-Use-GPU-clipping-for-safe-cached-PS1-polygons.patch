@@ -2273,6 +2273,8 @@ static int __attribute__((noinline)) draw_cached_flat_quad(
         x[i] = (int16_t)(sxy[i] & 0xffff);
         y[i] = (int16_t)(sxy[i] >> 16);
     }
+    if (!ps1_polygon_fits_gpu(x, y, 4))
+        return 2;
     if (!screen_front_facing_strict(x[0], y[0], x[1], y[1], x[2], y[2]) ||
         !screen_front_facing_strict(x[2], y[2], x[1], y[1], x[3], y[3]))
         return 2;
@@ -3041,10 +3043,13 @@ static void __attribute__((noinline)) cache_world_visibility(
                             const int32_t xy=s_static_screen_cache[static_vertex_offset+vi];
                             const int32_t z=s_static_depth_cache[static_vertex_offset+vi];
                             const int x=(int16_t)xy, y=(int16_t)(xy>>16);
+                            /* The GPU clips safe native polygons to the draw
+                             * area. Crossing a viewport edge alone does not
+                             * require a CPU polygon clip. */
                             s_static_projection_flags[static_vertex_offset+vi] =
                                 (ps1_projection_vertex_needs_clip(xy,z,entity_near_z,INT32_MAX,s_geom_screen) ? 1 : 0) |
                                 (s_static_camera_cache[static_vertex_offset+vi].vz>s_far_z ? 2 : 0) |
-                                (x < -2 || x>s_screen_w+1 || y < -2 || y>s_screen_h+1 ? 4 : 0);
+                                (x < -1020 || x > 1019 || y < -1020 || y > 1019 ? 4 : 0);
                         }
                         static_cache->visible_triangle_count = 0;
                         for(unsigned bi=0;bi<batch_count;++bi) {
@@ -3095,7 +3100,7 @@ static void __attribute__((noinline)) cache_world_visibility(
                                     &s_static_camera_cache[static_vertex_offset + p2]))
                                 continue;
                             int needs_clip = projection_flags != 0;
-                            if (!needs_clip && (!authored_floor_face(ent,face) || s_screen_w>1020 || s_screen_h>508)) {
+                            if (!needs_clip) {
                                 int min_x=(int16_t)xy0,max_x=min_x,min_y=(int16_t)(xy0>>16),max_y=min_y;
                                 const int x1=(int16_t)xy1,x2=(int16_t)xy2,y1=(int16_t)(xy1>>16),y2=(int16_t)(xy2>>16);
                                 if(x1<min_x)min_x=x1;if(x2<min_x)min_x=x2;
diff --git a/tests/Ps1GpuClippingTests.c b/tests/Ps1GpuClippingTests.c
new file mode 100644
index 0000000000000000000000000000000000000000..672be3072b3b6579dd008caf3da87283d5b7a00f
--- /dev/null
+++ b/tests/Ps1GpuClippingTests.c
@@ -0,0 +1,39 @@
+#include <stdio.h>
+#include <stdlib.h>
+#include "../templates/ps1/starter/runtime/projection_safety.h"
+
+static void check(int condition, const char* message) {
+    if (!condition) {
+        fprintf(stderr, "%s\n", message);
+        exit(1);
+    }
+}
+
+int main(void) {
+    const int16_t x[] = {-80, 400, -80, 400};
+    const int16_t y[] = {-40, -40, 280, 280};
+    check(ps1_polygon_fits_gpu(x, y, 4),
+          "Native polygons may cross all four viewport edges");
+    const int16_t boundary_x[] = {-510, 510, -510, 510};
+    const int16_t boundary_y[] = {-254, -254, 254, 254};
+    check(ps1_polygon_fits_gpu(boundary_x, boundary_y, 4),
+          "Polygons at the safe extent limit must remain eligible");
+    const int16_t wide[] = {-510, 511, -510, 511};
+    const int16_t tall[] = {-254, -254, 255, 255};
+    check(!ps1_polygon_fits_gpu(wide, y, 4), "Oversized width requires CPU clipping");
+    check(!ps1_polygon_fits_gpu(x, tall, 4), "Oversized height requires CPU clipping");
+    const int16_t saturated[] = {-1024, 100, -1024, 100};
+    check(!ps1_polygon_fits_gpu(saturated, y, 4),
+          "Saturated coordinates require CPU clipping");
+    check(!ps1_polygon_fits_gpu(x, y, 0), "Empty polygons are ineligible");
+    /* Depth/GTE saturation must retain CPU clipping independently of XY. */
+    check(ps1_projection_vertex_needs_clip(0, 1, 2, 5000, 160),
+          "The near plane must still clip");
+    check(ps1_projection_vertex_needs_clip(0, 6000, 2, 5000, 160),
+          "The far plane must still clip");
+    check(ps1_projection_vertex_needs_clip(0, 50, 2, 5000, 160),
+          "GTE division saturation must still clip");
+    check(!ps1_projection_vertex_needs_clip(0, 100, 2, 5000, 160),
+          "Valid depth must remain eligible");
+    return 0;
+}
