  "dialogues": [
    {
      "id": "relay_dead_frequency_lines",
      "name": "The Dead Frequency",
      "backgroundId": "star_field",
      "cast": [
        { "speaker": "Kestrel", "unitTypeId": "kestrel_rogue" },
        { "speaker": "Rook", "unitTypeId": "rook_commander" },
        { "speaker": "Morrow", "unitTypeId": "morrow_stormcaller" }
      ],
      "lines": [
        { "speaker": "Kestrel", "text": "Halcyon Relay, this is Recovery Two. Your tower has been dark for eighty-three years." },
        { "speaker": "Morrow", "text": "Incorrect. I have maintained the final watch for eighty-three years." },
        { "speaker": "Rook", "text": "Your final order came from people who are gone." },
        { "speaker": "Morrow", "text": "The order remains." }
      ]
    },
    {
      "id": "relay_opening_lines",
      "name": "The Tower Wakes",
      "cast": [
        { "speaker": "Kestrel", "unitTypeId": "kestrel_rogue" },
        { "speaker": "Morrow", "unitTypeId": "morrow_stormcaller" }
      ],
      "lines": [
        { "speaker": "Morrow", "text": "Withdraw beyond the marker stones. I am required to make the warning once." },
        { "speaker": "Kestrel", "text": "Then we only need to get close enough to give you a new answer." }
      ]
    },
    {
      "id": "relay_terms_lines",
      "name": "Terms at the Relay",
      "cast": [
        { "speaker": "Kestrel", "unitTypeId": "kestrel_rogue" },
        { "speaker": "Rook", "unitTypeId": "rook_commander" },
        { "speaker": "Morrow", "unitTypeId": "morrow_stormcaller" }
      ],
      "lines": [
        { "speaker": "Kestrel", "text": "Look past us. There is no army. There is no border. There are only villages that need the storm warning." },
        { "speaker": "Morrow", "text": "My order protects the relay from every claimant." },
        { "speaker": "Rook", "text": "We are not claiming it. We are asking you to keep watch for someone who can still hear it." },
        { "speaker": "Morrow", "text": "That is not the same order." }
      ]
    },
    {
      "id": "relay_new_watch_lines",
      "name": "A New Watch",
      "backgroundId": "star_field",
      "cast": [
        { "speaker": "Kestrel", "unitTypeId": "kestrel_rogue" },
        { "speaker": "Rook", "unitTypeId": "rook_commander" },
        { "speaker": "Morrow", "unitTypeId": "morrow_stormcaller" }
      ],
      "lines": [
        { "speaker": "Morrow", "text": "Weather front detected west of the valley. I can reach three settlements before it arrives." },
        { "speaker": "Kestrel", "text": "Then the relay is not dead." },
        { "speaker": "Rook", "text": "And this time, the watch is yours to choose." },
        { "speaker": "Morrow", "text": "No. Its order has changed." }
      ]
    },
    {
      "id": "relay_silent_lines",
      "name": "The Silent Relay",
      "backgroundId": "star_field",
      "cast": [
        { "speaker": "Kestrel", "unitTypeId": "kestrel_rogue" },
        { "speaker": "Rook", "unitTypeId": "rook_commander" }
      ],
      "lines": [
        { "speaker": "Kestrel", "text": "The warning array still works. Morrow made sure of that." },
        { "speaker": "Rook", "text": "Bring it online. We can regret the rest after the storm passes." }
      ]
    }
  ],
