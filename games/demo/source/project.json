  "items": [
    {
      "id": "field_tonic",
      "name": "Field Tonic",
      "itemTypeId": "consumable",
      "stackLimit": 5,
      "kind": "restore",
      "power": 2,
      "notes": "Two back, drunk on the spot. A rider carries one and a picket leaves one, which is the whole of the demo's inventory: one thing to spend in a battle and one thing to win from it, so the campaign's store can be shown both going down and going up across a save."
    }
  ],
