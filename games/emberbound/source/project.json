  "dialogues": [
    {
      "id": "prologue", "name": "The Bell Goes Dark", "backgroundId": "mountain_dusk",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" }
      ],
      "lines": [
        { "speaker": "Senna", "text": "The western road has vanished from my map. Not faded—vanished." },
        { "speaker": "Auren", "text": "Roads do not vanish. Bell-ringers do when they are late, though." },
        { "speaker": "Senna", "text": "Auren. The sun is setting in the east." },
        { "speaker": "Auren", "text": "Then we ring the warning bell first and panic second." },
        { "speaker": "Orra", "text": "Two hands have reached for the same light. The light remembers." },
        { "speaker": "Senna", "text": "Tell me the bell did not just speak." }
      ]
    },
    {
      "id": "tutorial_orders", "name": "First Light",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" }
      ],
      "lines": [
        { "speaker": "Orra", "text": "Move together. Close the distance, then strike. Each fighter may move and act before yielding." },
        { "speaker": "Auren", "text": "You take the lower path. I will keep them off the bell." },
        { "speaker": "Senna", "text": "That sounded almost like a plan." },
        { "speaker": "Orra", "text": "A plan is only a promise made to the person beside you." }
      ]
    },
    {
      "id": "rowanfield_won", "name": "The Choosing", "backgroundId": "night_camp",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Brann", "unitTypeId": "brann_vanguard" },
        { "speaker": "Ilyra", "unitTypeId": "ilyra_scout" }
      ],
      "lines": [
        { "speaker": "Orra", "text": "The paired embers woke because each of you turned back for the other. Not blood. Not prophecy. Choice." },
        { "speaker": "Auren", "text": "Choice to do what?" },
        { "speaker": "Orra", "text": "Carry dawn to the five beacons before Regent Veyr hollows the last flame." },
        { "speaker": "Senna", "text": "Every map says the Crown Road ends at Glasswater." },
        { "speaker": "Ilyra", "text": "Then your maps need a scout who has crossed it." },
        { "speaker": "Brann", "text": "And the scout needs someone large enough to stand where the arrows land." },
        { "speaker": "Auren", "text": "We leave at first light—if first light still comes." }
      ]
    },
    {
      "id": "thorn_orders", "name": "The Road Answers",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Ilyra", "unitTypeId": "ilyra_scout" }
      ],
      "lines": [
        { "speaker": "Ilyra", "text": "Raiders ahead. They are guarding the road from people trying to leave, not enter." },
        { "speaker": "Auren", "text": "Then we open it in both directions." },
        { "speaker": "Senna", "text": "Two lines. No one fights alone." }
      ]
    },
    {
      "id": "thorn_won", "name": "People, Not Pieces", "backgroundId": "deep_wood",
      "cast": [
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Oren", "unitTypeId": "oren_keeper" },
        { "speaker": "Tess", "unitTypeId": "tess_sapper" }
      ],
      "lines": [
        { "speaker": "Tess", "text": "I built their cinder traps. Veyr promised one frozen year would spare us a thousand bad ones." },
        { "speaker": "Senna", "text": "And when the frozen year ends?" },
        { "speaker": "Tess", "text": "He never said it would." },
        { "speaker": "Oren", "text": "The old lanterns can divide the burden. One flame does not need to hold the whole sky." },
        { "speaker": "Auren", "text": "Can you relight them?" },
        { "speaker": "Oren", "text": "Can you get me to them?" },
        { "speaker": "Tess", "text": "I know every lock I made for the Crown. I am coming too." }
      ]
    },
    {
      "id": "glasswater_orders", "name": "The Unmapped Crossing",
      "cast": [
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" }
      ],
      "lines": [
        { "speaker": "Senna", "text": "The causeway is broken in every survey." },
        { "speaker": "Auren", "text": "Good. We are no longer following the old map." },
        { "speaker": "Senna", "text": "I was hoping you would say something less terrifying." }
      ]
    },
    {
      "id": "glasswater_won", "name": "An Army Learns Its Shape", "backgroundId": "open_sea",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Brann", "unitTypeId": "brann_vanguard" }
      ],
      "lines": [
        { "speaker": "Auren", "text": "I kept trying to see all six of us at once." },
        { "speaker": "Brann", "text": "That is how commanders miss the person in front of them." },
        { "speaker": "Senna", "text": "Give us the destination, not every footstep." },
        { "speaker": "Auren", "text": "Then here it is: we reach the vault together. You choose how." },
        { "speaker": "Orra", "text": "The ember grows brighter when carried, not when hoarded." }
      ]
    },
    {
      "id": "vault_orders", "name": "The First Flame",
      "cast": [
        { "speaker": "Oren", "unitTypeId": "oren_keeper" },
        { "speaker": "Tess", "unitTypeId": "tess_sapper" }
      ],
      "lines": [
        { "speaker": "Oren", "text": "The vault is still alive. I can hear the relays answering one another." },
        { "speaker": "Tess", "text": "So can the Crown. Wardens are coming from both galleries." },
        { "speaker": "Senna", "text": "Then each army takes a gallery. We meet at the flame." }
      ]
    },
    {
      "id": "before_regent", "name": "What the Crown Preserves", "backgroundId": "throne_hall",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Veyr", "unitTypeId": "regent_veyr" }
      ],
      "lines": [
        { "speaker": "Veyr", "text": "You have seen the failing roads. The empty wells. I did not invent the end." },
        { "speaker": "Auren", "text": "You only decided nobody else was allowed to face it." },
        { "speaker": "Veyr", "text": "I can preserve this world exactly as it is. No child will watch another dawn fail." },
        { "speaker": "Senna", "text": "Exactly as it is means no child grows old enough to change it." },
        { "speaker": "Veyr", "text": "And you trust six frightened people with the sky?" },
        { "speaker": "Auren", "text": "No. We trust every village with a piece of it." },
        { "speaker": "Senna", "text": "That is the part your crown never understood." }
      ]
    },
    {
      "id": "regent_orders", "name": "The Hollow Crown",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Veyr", "unitTypeId": "regent_veyr" }
      ],
      "lines": [
        { "speaker": "Veyr", "text": "Then carry your little dawn against the weight of every night I held back." },
        { "speaker": "Auren", "text": "Brann, Oren—with me. We break the centre." },
        { "speaker": "Senna", "text": "Ilyra, Tess—we clear the flanks. No one gets isolated." },
        { "speaker": "Orra", "text": "Two embers. Six bearers. One choice, made together." }
      ]
    },
    {
      "id": "epilogue", "name": "A Dawn Shared", "backgroundId": "star_field",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" },
        { "speaker": "Tess", "unitTypeId": "tess_sapper" },
        { "speaker": "Ilyra", "unitTypeId": "ilyra_scout" }
      ],
      "lines": [
        { "speaker": "Orra", "text": "The Crown is open. One bearer may command the flame." },
        { "speaker": "Auren", "text": "That is how this started." },
        { "speaker": "Senna", "text": "Divide it among the five beacons. Leave the sixth part here, unclaimed." },
        { "speaker": "Tess", "text": "The relays will need keepers in every settlement." },
        { "speaker": "Ilyra", "text": "And roads between them that do not vanish from maps." },
        { "speaker": "Auren", "text": "We were chosen because we turned back for each other." },
        { "speaker": "Senna", "text": "So we make a world where choosing each other is ordinary." },
        { "speaker": "Orra", "text": "The light does not remember kings. It remembers hands." }
      ]
    },
    {
      "id": "defeat", "name": "The Ember Waits", "backgroundId": "mountain_dusk",
      "cast": [
        { "speaker": "Auren", "unitTypeId": "auren_wayfarer" },
        { "speaker": "Senna", "unitTypeId": "senna_lumen" }
      ],
      "lines": [
        { "speaker": "Orra", "text": "This road ends in ash—but it is only one road." },
        { "speaker": "Auren", "text": "Then show us the turning." },
        { "speaker": "Senna", "text": "No. We remember it, and choose better when the bell rings again." },
        { "speaker": "Orra", "text": "The ember waits for hands willing to reach for one another." }
      ]
    }
  ],
