{
  "name": "@grandleon/ui-framework-spike",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build:react": "vite build --config vite.react.config.ts",
    "build:vue": "vite build --config vite.vue.config.ts",
    "build:svelte": "vite build --config vite.svelte.config.ts",
    "build": "npm run build:react && npm run build:vue && npm run build:svelte",
    "test": "node test.mjs",
    "measure": "node measure.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "svelte": "5.56.8",
    "vue": "3.5.40"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "7.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "@vitejs/plugin-vue": "6.0.8",
    "typescript": "6.0.3",
    "vite": "8.2.0"
  }
}
