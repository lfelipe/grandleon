{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandleon.dev/schemas/spikes/ui-framework-results.schema.json",
  "type": "object",
  "properties": {
    "commit": { "type": "string", "minLength": 7 },
    "measuredAt": { "type": "string" },
    "environment": {
      "type": "object",
      "properties": {
        "node": { "type": "string" },
        "npm": { "type": "string" },
        "os": { "type": "string" },
        "cpu": { "type": "string" }
      },
      "required": ["node", "npm", "os", "cpu"],
      "additionalProperties": false
    },
    "candidates": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "items": {
        "type": "object",
        "properties": {
          "name": { "enum": ["react", "vue", "svelte"] },
          "version": { "type": "string" },
          "initialJsGzipBytes": { "type": "integer", "minimum": 0 },
          "initialCssGzipBytes": { "type": "integer", "minimum": 0 },
          "buildMilliseconds": {
            "type": "array",
            "minItems": 3,
            "items": { "type": "integer", "minimum": 0 }
          },
          "testsPassed": { "type": "boolean" },
          "accessibilitySeriousOrCritical": {
            "type": "integer",
            "minimum": 0
          },
          "productionHighOrCriticalAdvisories": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "name",
          "version",
          "initialJsGzipBytes",
          "initialCssGzipBytes",
          "buildMilliseconds",
          "testsPassed",
          "accessibilitySeriousOrCritical",
          "productionHighOrCriticalAdvisories"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": ["commit", "measuredAt", "environment", "candidates"],
  "additionalProperties": false
}
