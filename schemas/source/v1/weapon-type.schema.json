  "$id": "https://grandleon.dev/schemas/source/v1/weapon-type.schema.json",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "name": { "$ref": "common.schema.json#/$defs/displayName" },
