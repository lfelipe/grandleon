{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://grandleon.dev/schemas/source/v1/map.schema.json",
  "type": "object",
  "properties": {
    "id": { "$ref": "common.schema.json#/$defs/stableId" },
    "name": { "$ref": "common.schema.json#/$defs/displayName" },
    "width": { "type": "integer", "minimum": 1, "maximum": 256 },
    "height": { "type": "integer", "minimum": 1, "maximum": 256 },
    "terrain": {
      "type": "array",
      "items": { "$ref": "common.schema.json#/$defs/stableId" },
      "maxItems": 65536
    },
    "notes": { "$ref": "common.schema.json#/$defs/notes" },
    "extensions": { "$ref": "common.schema.json#/$defs/extensions" }
  },
  "required": ["id", "name", "width", "height", "terrain"],
  "additionalProperties": false
}
