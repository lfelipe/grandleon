{
  "name": "Grandleon",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "remoteUser": "grandleon",
  "workspaceFolder": "/workspaces/grandleon",
  "mounts": [
    "source=/var/run/docker.sock,target=/var/run/docker.sock,type=bind"
  ],
  "containerEnv": {
    "PLAYWRIGHT_BROWSERS_PATH": "/workspaces/grandleon/.playwright-browsers"
  },
  "postCreateCommand": "scripts/setup.sh",
  "customizations": {
    "vscode": {
      "extensions": [
        "ms-vscode.cpptools",
        "Vue.volar",
        "ms-playwright.playwright"
      ]
    }
  }
}
