set(install_prefix "@CMAKE_CURRENT_BINARY_DIR@/tarnholt-sdk-install")
set(demo_build "@CMAKE_CURRENT_BINARY_DIR@/game-tarnholt-build")
set(package_path "@CMAKE_CURRENT_BINARY_DIR@/tarnholt-test.gpk")

execute_process(
    COMMAND
        "@CMAKE_COMMAND@" --install "@CMAKE_BINARY_DIR@"
        --prefix "${install_prefix}"
    RESULT_VARIABLE install_result
)
if(NOT install_result EQUAL 0)
    message(FATAL_ERROR "SDK install failed")
endif()

execute_process(
    COMMAND
        "@CMAKE_COMMAND@"
        -S "@CMAKE_SOURCE_DIR@/games/tarnholt"
        -B "${demo_build}"
        "-DCMAKE_PREFIX_PATH=${install_prefix}"
        "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@"
        "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@"
    RESULT_VARIABLE configure_result
)
if(NOT configure_result EQUAL 0)
    message(FATAL_ERROR "Tarnholt configure failed")
endif()

execute_process(
    COMMAND "@CMAKE_COMMAND@" --build "${demo_build}"
    RESULT_VARIABLE build_result
)
if(NOT build_result EQUAL 0)
    message(FATAL_ERROR "Tarnholt build failed")
endif()

execute_process(
    COMMAND
        "${install_prefix}/@CMAKE_INSTALL_BINDIR@/grandleon_content_compile"
        "@CMAKE_SOURCE_DIR@/games/tarnholt/source/project.json"
        "${package_path}"
    RESULT_VARIABLE package_result
)
if(NOT package_result EQUAL 0)
    message(FATAL_ERROR "Tarnholt package compilation failed")
endif()

execute_process(
    COMMAND
        "${install_prefix}/@CMAKE_INSTALL_BINDIR@/grandleon_package_check"
        "${package_path}"
    RESULT_VARIABLE check_result
)
if(NOT check_result EQUAL 0)
    message(FATAL_ERROR "Installed package checker rejected tarnholt package")
endif()

execute_process(
    COMMAND "${demo_build}/grandleon_tarnholt_playthrough" "${package_path}"
    RESULT_VARIABLE playthrough_result
    OUTPUT_VARIABLE playthrough_output
)
if(NOT playthrough_result EQUAL 0)
    message(FATAL_ERROR "Tarnholt playthrough failed")
endif()
if(NOT playthrough_output MATCHES
   "^tarnholt ford_hash=[0-9]+ watch_hash=[0-9]+ campaign=valley_held")
    message(FATAL_ERROR "Tarnholt produced unexpected result: ${playthrough_output}")
endif()
