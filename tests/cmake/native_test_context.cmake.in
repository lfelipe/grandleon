# SPDX-License-Identifier: MIT
# Keep external-consumer checks on the same target ABI as their installed SDK.
set(test_config "@CMAKE_BUILD_TYPE@")
if(DEFINED GRANDLEON_TEST_CONFIG AND NOT GRANDLEON_TEST_CONFIG STREQUAL "")
    set(test_config "${GRANDLEON_TEST_CONFIG}")
endif()
set(test_runtime_subdir "")
if(NOT "@CMAKE_CONFIGURATION_TYPES@" STREQUAL "")
    if(test_config STREQUAL "")
        set(configurations "@CMAKE_CONFIGURATION_TYPES@")
        list(GET configurations 0 test_config)
    endif()
    set(test_runtime_subdir "/${test_config}")
endif()
set(test_exe_suffix "@CMAKE_EXECUTABLE_SUFFIX@")
set(test_run_prefix "@CMAKE_CROSSCOMPILING_EMULATOR@")
set(test_configure_args
    -G "@CMAKE_GENERATOR@"
    "-DCMAKE_CXX_COMPILER=@CMAKE_CXX_COMPILER@"
    "-DCMAKE_BUILD_TYPE=${test_config}"
    "-DCMAKE_CXX_FLAGS=@CMAKE_CXX_FLAGS@"
    "-DCMAKE_EXE_LINKER_FLAGS=@CMAKE_EXE_LINKER_FLAGS@")
if(NOT "@CMAKE_TOOLCHAIN_FILE@" STREQUAL "")
    list(APPEND test_configure_args "-DCMAKE_TOOLCHAIN_FILE=@CMAKE_TOOLCHAIN_FILE@")
endif()

function(grandleon_test_sdk_location prefix)
    # A cross toolchain re-roots package searches. Native checks keep the
    # ordinary CMAKE_PREFIX_PATH discovery contract unchanged.
    set(arguments)
    if("@CMAKE_CROSSCOMPILING@")
        list(APPEND arguments
            "-DGrandleonPackageSdk_DIR=${prefix}/@CMAKE_INSTALL_LIBDIR@/cmake/GrandleonPackageSdk")
    endif()
    set(test_sdk_location_args "${arguments}" PARENT_SCOPE)
endfunction()
