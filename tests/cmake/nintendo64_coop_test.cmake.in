# Builds Emberbound's dedicated two-controller Nintendo 64 autopilot and runs
# it in the pinned ares emulator. The ROM alternates synthetic edges between
# controller ports one and two, then checks ownership, independent cursor and
# selection state, accepted commands from both players, encounter scaling and
# the next round from inside the console presenter.

set(ENV{GRANDLEON_LIBDRAGON_BASE_IMAGE} "@GRANDLEON_LIBDRAGON_BASE_IMAGE@")
set(ENV{GRANDLEON_LIBDRAGON_BASE_DIGEST} "@GRANDLEON_LIBDRAGON_BASE_DIGEST@")
set(ENV{GRANDLEON_LIBDRAGON_COMMIT} "@GRANDLEON_LIBDRAGON_COMMIT@")
set(ENV{GRANDLEON_DOCKER} "@GRANDLEON_DOCKER@")
set(ENV{GRANDLEON_N64_BUILD_DIR} "@GRANDLEON_N64_BUILD_DIR@")

execute_process(
    COMMAND
        "@PROJECT_SOURCE_DIR@/platform/nintendo64/scripts/check-n64.sh"
        --check coop
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "the Nintendo 64 two-controller co-op ROM failed")
endif()
