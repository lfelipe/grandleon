# Builds the Nintendo 64 ROMs in the pinned libdragon container and replays
# the campaign autopilot (synthetic controller input through the real
# interactive screens) under the pinned ares container. ares is the
# authoritative emulator for this console (docs/ARES_VALIDATION.md), and a ROM that draws
# through the RDP cannot run anywhere else.
#
# Through `check-n64.sh`, which is where a check gets defined: which ROM, under
# what budget, including this one's raised budget. So this lane and
# `grandleon_n64_autopilot_check` cannot come to mean different things.

set(ENV{GRANDLEON_LIBDRAGON_BASE_IMAGE} "@GRANDLEON_LIBDRAGON_BASE_IMAGE@")
set(ENV{GRANDLEON_LIBDRAGON_BASE_DIGEST} "@GRANDLEON_LIBDRAGON_BASE_DIGEST@")
set(ENV{GRANDLEON_LIBDRAGON_COMMIT} "@GRANDLEON_LIBDRAGON_COMMIT@")
set(ENV{GRANDLEON_DOCKER} "@GRANDLEON_DOCKER@")
set(ENV{GRANDLEON_N64_BUILD_DIR} "@GRANDLEON_N64_BUILD_DIR@")

execute_process(
    COMMAND
        "@PROJECT_SOURCE_DIR@/platform/nintendo64/scripts/check-n64.sh"
        --check autopilot
    WORKING_DIRECTORY "@PROJECT_SOURCE_DIR@"
    RESULT_VARIABLE run_result
)
if(NOT run_result EQUAL 0)
    message(FATAL_ERROR "the Nintendo 64 autopilot did not report a pass")
endif()
