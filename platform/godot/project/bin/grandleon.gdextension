[configuration]

entry_symbol = "grandleon_library_init"
compatibility_minimum = "4.7"
reloadable = false

[libraries]

linux.debug.x86_64 = "res://bin/libgrandleon_godot.so"
linux.release.x86_64 = "res://bin/libgrandleon_godot.so"

windows.debug.x86_64 = "res://bin/grandleon_godot.dll"
windows.release.x86_64 = "res://bin/grandleon_godot.dll"

android.debug.arm64 = "res://bin/android/arm64-v8a/libgrandleon_godot.so"
android.release.arm64 = "res://bin/android/arm64-v8a/libgrandleon_godot.so"
android.debug.x86_64 = "res://bin/android/x86_64/libgrandleon_godot.so"
android.release.x86_64 = "res://bin/android/x86_64/libgrandleon_godot.so"
