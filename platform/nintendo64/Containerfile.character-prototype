# Reproducible Nintendo 64 3D-character prototype toolchain.
#
# libdragon publishes a container image, but it holds the mips64-elf GCC cross
# compiler only: there is no libdragon in it, no n64.mk, no libdragon.a, no
# n64tool and no linker script. So the published image is pinned by digest and
# used as a base, and this file adds one pinned libdragon commit on top.
#
# Built only by build-character-prototype.sh. The supported campaign renderer
# continues to use Containerfile and its stable libdragon pin.

FROM ghcr.io/dragonminded/libdragon@sha256:cf979424d0c2d3e281fda0820e8244def9b2debea2ab140c6513e41c8b66cdd0

# Tiny3D requires the libdragon preview API used by the measured prototype.
ARG LIBDRAGON_COMMIT=c79a52b42ac790e06e797aede43914dd8754cd5f
ARG TINY3D_COMMIT=517156d9464aaab95bf9531336d9a57624405ca7

# The base image carries the cross compiler and host GCC, but no CMake, and the
# engine is a CMake build.
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install --yes --no-install-recommends \
        ca-certificates \
        cmake \
        xz-utils \
    && rm -rf /var/lib/apt/lists/*

ENV N64_INST=/n64_toolchain

# A shallow fetch of one commit, so the image does not carry libdragon history.
RUN mkdir -p /tmp/libdragon \
    && cd /tmp/libdragon \
    && git init --quiet \
    && git remote add origin https://github.com/DragonMinded/libdragon.git \
    && git fetch --quiet --depth 1 origin "${LIBDRAGON_COMMIT}" \
    && git checkout --quiet FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${LIBDRAGON_COMMIT}" \
    && make -j"$(nproc)" install-mk \
    && make -j"$(nproc)" libdragon tools \
    && make -j"$(nproc)" install tools-install \
    && printf '%s\n' "${LIBDRAGON_COMMIT}" > "${N64_INST}/LIBDRAGON_COMMIT" \
    && mkdir -p \
        /tmp/grandleon-toolchain-licenses/libdragon/src/fatfs \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/audioconv64/libsamplerate \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/freetype \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/plutosvg \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/rect_pack \
    && install -m 0644 LICENSE.md \
        /tmp/grandleon-toolchain-licenses/libdragon/LICENSE.md \
    && install -m 0644 src/fatfs/License.md \
        /tmp/grandleon-toolchain-licenses/libdragon/src/fatfs/License.md \
    && install -m 0644 ./tools/audioconv64/libsamplerate/COPYING \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/audioconv64/libsamplerate/COPYING \
    && install -m 0644 ./tools/mkfont/freetype/LICENSE.TXT \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/freetype/LICENSE.TXT \
    && install -m 0644 ./tools/mkfont/freetype/FTL.TXT \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/freetype/FTL.TXT \
    && install -m 0644 ./tools/mkfont/freetype/GPLv2.TXT \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/freetype/GPLv2.TXT \
    && install -m 0644 ./tools/mkfont/plutosvg/FTL.TXT \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/plutosvg/FTL.TXT \
    && install -m 0644 ./tools/mkfont/rect_pack/LICENSE \
        /tmp/grandleon-toolchain-licenses/libdragon/tools/mkfont/rect_pack/LICENSE \
    && cd / \
    && rm -rf /tmp/libdragon

# Tiny3D is the only additional runtime component in the prototype. Keep its
# exact MIT notice both in the image inventory and in the repository bundle.
RUN mkdir -p /tmp/tiny3d \
    && cd /tmp/tiny3d \
    && git init --quiet \
    && git remote add origin https://github.com/HailToDodongo/tiny3d.git \
    && git fetch --quiet --depth 1 origin "${TINY3D_COMMIT}" \
    && git checkout --quiet FETCH_HEAD \
    && test "$(git rev-parse HEAD)" = "${TINY3D_COMMIT}" \
    && make -j"$(nproc)" \
    && make install \
    && printf '%s\n' "${TINY3D_COMMIT}" > "${N64_INST}/TINY3D_COMMIT" \
    && mkdir -p /tmp/grandleon-toolchain-licenses/tiny3d \
    && install -m 0644 LICENSE \
        /tmp/grandleon-toolchain-licenses/tiny3d/LICENSE \
    && tar -C /tmp/grandleon-toolchain-licenses -cJf \
        /GRANDLEON_TOOLCHAIN_LICENSES.tar.xz . \
    && printf '%s\t%s\t%s\n' \
        libdragon "${LIBDRAGON_COMMIT}" Unlicense \
        FatFs "libdragon-${LIBDRAGON_COMMIT}" LicenseRef-FatFs \
        libsamplerate "libdragon-${LIBDRAGON_COMMIT}" BSD-2-Clause \
        FreeType "libdragon-${LIBDRAGON_COMMIT}" FTL \
        PlutoSVG "libdragon-${LIBDRAGON_COMMIT}" FTL \
        rect_pack "libdragon-${LIBDRAGON_COMMIT}" Unlicense \
        Tiny3D "${TINY3D_COMMIT}" MIT \
        > /GRANDLEON_TOOLCHAIN_COMPONENTS.tsv \
    && cd / \
    && rm -rf /tmp/tiny3d /tmp/grandleon-toolchain-licenses
